APP_ENV=production
APP_DEBUG=false
APP_URL=https://attendance.example.co.jp
APP_TIMEZONE=Asia/Tokyo
SESSION_IDLE_MINUTES=60
REMEMBER_LOGIN_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance
DB_USER=attendance_user
DB_PASS=change-me

MAIL_FROM=no-reply@j-style-tokyo.com
MAIL_FROM_NAME=社内勤怠管理

# 問い合わせ通知（Chatwork）。トークンと送信先ルームIDを設定すると問い合わせ機能が有効になる。
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=

# Googleフォーム打刻連携（public/webhook.php）。十分に長いランダム文字列を設定し、Apps Script側と一致させる。
# 空のままだとWebhookは常に401を返す（連携無効）。
FORM_WEBHOOK_TOKEN=

# `php scripts/generate-vapid-keys.php` で1組だけ生成し、全サーバーで同じ組を維持します。
VAPID_SUBJECT=mailto:admin@example.co.jp
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_REMINDER_TIME=18:00
